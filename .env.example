# ==============================================================================
# LifestyleNG.com — Environment Configuration Template
# Parent Organization: Lifestyle Corporate Networks Ltd. (Abuja, Nigeria)
# Copy this file to `.env.local` for local development or configure these keys
# inside Hostinger hPanel -> Websites -> Node.js Web App -> Environment Variables.
# NEVER commit `.env` or `.env.local` with real production secrets to Git.
# ==============================================================================

# --- Core Application & Custom Domain ---
NODE_ENV="development"
# Set to "https://lifestyleng.com" in production on Hostinger
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_WHATSAPP_PRIMARY="2348064912969"
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=""

# --- Admin CMS Authentication (/admin/login -> /admin) ---
# REQUIRED IN PRODUCTION: Set ADMIN_EMAIL and either ADMIN_PASSWORD_HASH (recommended)
# or ADMIN_PASSWORD in Hostinger Environment Variables.
# Generate a scrypt password hash locally with:
#   node -e "const c=require('crypto'),s=c.randomBytes(16).toString('hex'),h=c.scryptSync('YOUR_STRONG_PASSWORD',s,64).toString('hex');console.log(s+':'+h)"
ADMIN_EMAIL="admin@lifestyleng.com"
ADMIN_PASSWORD=""
ADMIN_PASSWORD_HASH=""
# Generate a strong random 32+ character string before production launch:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="lifestyleng_local_development_session_secret_key_32chars"

# --- Managed PostgreSQL Database (Hostinger / Neon / Supabase) ---
# When connected to a live PostgreSQL server, `/admin` CMS automatically persists
# products, categories, apartments, rooms, fleet, and pages in PostgreSQL (`cms_state`).
DATABASE_URL="postgresql://lifestyleng:local_dev_password@localhost:5432/lifestyleng_core"
CRON_SECRET="lifestyleng_cron_sweeper_secret_2026"

# --- Payment Mode & Gateways ---
# Supported values: "sandbox" (pre-launch test & bank transfer mode) | "live"
NEXT_PUBLIC_PAYMENT_MODE="sandbox"

# Optional Paystack credentials (keep test placeholders while running in sandbox/bank-transfer mode)
PAYSTACK_SECRET_KEY="sk_test_lifestyleng_placeholder_key"
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_test_lifestyleng_placeholder_key"

# Optional Flutterwave credentials (leave placeholders unless enabling Flutterwave)
FLUTTERWAVE_SECRET_KEY="FLWSECK_TEST_lifestyleng_placeholder"
FLUTTERWAVE_WEBHOOK_SECRET_HASH="lifestyleng_flw_webhook_secret_hash_2026"

# --- Transactional Email & Object Storage (Optional in Pre-Launch) ---
RESEND_API_KEY="re_test_lifestyleng_placeholder"
S3_ENDPOINT="https://s3.eu-west-1.amazonaws.com"
S3_ACCESS_KEY_ID="AKIAIOSFODNN7EXAMPLE"
S3_SECRET_ACCESS_KEY="wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"
S3_BUCKET_NAME="lifestyleng-media"
